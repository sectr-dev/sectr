// docs.sectr.dev — STATIC-ASSETS-ONLY Cloudflare Worker.
//
// No `main`, no bindings, no runtime code — wrangler uploads
// ./dist as static assets. Every page is prerendered by `astro build`
// (docs-site has NO Astro adapter by design).
//
// Deploys: the Cloudflare↔GitHub integration (Workers Builds) — build &
// deploy run on every push to main, same model as dashboard/ (which
// deploys from root dir dashboard/). Configure in the Cloudflare
// dashboard: root dir docs-site/, build `npm ci && npm run build`,
// assets via this wrangler.jsonc. No CI workflow — the release's
// docs guarantee is the smoke check in scripts/smoke-docs.sh (stage
// smoke-docs of `just release`), which polls the live site after the
// merge-back push and asserts the sidebar version footer shows
// the released version.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "docs-sectr-dev",
    "compatibility_date": "2026-09-22",
    "assets": {
        "directory": "./dist",
    },
    // Keep the workers.dev URL reachable: fallback + first-deploy surface
    // (the docs.sectr.dev custom domain attaches to the deployed service),
    // and a useful probe before DNS applies.
    "preview_urls": true,
}