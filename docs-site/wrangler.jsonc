// docs.sectr.dev — STATIC-ASSETS-ONLY Cloudflare Worker.
//
// No `main`, no bindings, no runtime code — wrangler uploads
// ./dist as static assets. Every page is prerendered by `astro build`
// (docs-site has NO Astro adapter by design).
//
// Deploys: with a release (its deploy-docs stage), or `just redeploy docs`
// from main for a docs-only fix (scripts/deploy-site.sh). Both run `npm
// run build` and upload ./dist with this file via `wrangler deploy`, then
// check the sidebar footer shows the version. Pushes to main don't deploy
// it.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "docs-sectr-dev",
    "compatibility_date": "2026-09-22",
    "assets": {
        "directory": "./dist",
    },
    // Keep the workers.dev URL reachable: fallback + first-deploy surface
    // (the docs.sectr.dev custom domain attaches to the deployed service),
    // and a useful probe before DNS applies.
    "preview_urls": true,
}