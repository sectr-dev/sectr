# Self-hosted Sectr settings. ./setup.sh copies this to .env and fills in the
# generated values. The guide explains each one:
# https://docs.sectr.dev/guides/self-hosting/

# The Sectr version to run. To upgrade, change this and run:
#   docker compose pull && docker compose up -d
SECTR_VERSION=0.2.0

# Generated by setup.sh. The platform key is how you first sign in.
SECTR_BOOTSTRAP_PLATFORM_KEY=
# Encrypts secrets at rest. If you lose it, stored secrets can't be read.
SECTR_SECRETS_MASTER_KEY=
POSTGRES_PASSWORD=

# The database. Must be a direct connection, not a pooler such as PgBouncer:
# live streams use LISTEN/NOTIFY. To use your own, change this URL and remove
# `postgres` from COMPOSE_PROFILES.
SECTR_PG_URL=
COMPOSE_PROFILES=postgres

# How browsers and the CLI reach this install. On a remote machine, set these
# to your public URLs.
SECTR_PUBLIC_API_URL=http://localhost:8080
SECTR_DASHBOARD_URL=http://localhost:3000

# How runners reach the server. These work as they are.
SECTR_RUNNER_NETWORK=sectr-runners
SECTR_RUNNER_SERVER_URL=ws://sectr-server:8080/ingest

# Concurrent turns. 0 turns off a limit. Set the total for runners to fit this
# machine: with the default limits below, each turn can use 1 CPU and 1 GB.
# Turns of apps on their own compute endpoint run elsewhere and have limits of
# their own.
SECTR_MAX_CONCURRENT_SANDBOX_TURNS_PER_APP=0
SECTR_MAX_CONCURRENT_SANDBOX_TURNS=10
SECTR_MAX_CONCURRENT_ENDPOINT_TURNS_PER_APP=0
SECTR_MAX_CONCURRENT_ENDPOINT_TURNS=0

# Optional.
# Limits on each runner.
# SECTR_RUNNER_CPU_COUNT=1
# SECTR_RUNNER_MEMORY_MB=1024
# SECTR_RUNNER_TIMEOUT_SECS=3600
# The ports to publish. Add an address to keep one off the public internet,
# for example behind a reverse proxy: SECTR_SERVER_PORT=127.0.0.1:8080
# SECTR_SERVER_PORT=8080
# SECTR_DASHBOARD_PORT=3000
# The Docker socket, if it isn't at the usual path (rootless Docker).
# SECTR_DOCKER_SOCKET_PATH=/var/run/docker.sock
# Your organization's name in the dashboard.
# SECTR_ORG_NAME=sectr
# Endpoint deployments: agents on your own serverless or containers, which
# the server wakes for each turn. Set this to the server's ingest as those
# platforms reach it to turn them on.
# SECTR_ENDPOINT_INGEST_URL=wss://api.sectr.example.com/ingest
# Allow endpoints on private addresses and plain http (your own network).
# SECTR_ENDPOINT_ALLOW_PRIVATE=false
