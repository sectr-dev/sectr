{
  "name": "sectr",
  "version": "0.0.0",
  "description": "Reserved for the Sectr JS SDK. For CopilotKit apps, use @sectr/copilotkit.",
  "keywords": [
    "sectr",
    "ai",
    "agents"
  ],
  "homepage": "https://sectr.dev",
  "license": "MIT",
  "author": {
    "name": "Donald Pinckney",
    "email": "donald.pinckney@sectr.dev"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "5.9.3"
  }
}
